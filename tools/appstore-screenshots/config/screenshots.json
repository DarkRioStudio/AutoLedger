      "subtitle": {
        "zh-Hans": "在 Apple Watch 上快速开始记录",
        "zh-Hant": "在 Apple Watch 上快速開始記錄",
        "en": "Start a record quickly on Apple Watch"
      }
    },
    {
      "id": "01_watch_recent",
      "scene": "watch_recent",
      "title": {
        "zh-Hans": "最近账单随手查看",
        "zh-Hant": "最近帳單隨手查看",
        "en": "Recent records at a glance"
      },
      "subtitle": {
        "zh-Hans": "常用消费记录一眼可见",
        "zh-Hant": "常用消費記錄一眼可見",
        "en": "Check everyday spending without pulling out your phone"
      }
    },
    {
      "id": "02_watch_confirm",
      "scene": "watch_confirm",
      "title": {
        "zh-Hans": "关键信息清楚确认",
        "zh-Hant": "關鍵資訊清楚確認",
        "en": "Confirm key details"
      },
      "subtitle": {
        "zh-Hans": "金额、分类与来源尽量少操作",
        "zh-Hant": "金額、分類與來源盡量少操作",
        "en": "Keep amount, category, and source easy to review"
