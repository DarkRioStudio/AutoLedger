{
  "name": "@darkrio/common-api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "dev": "wrangler dev",
    "d1:migrate:staging": "wrangler d1 migrations apply COMMON_API_DB --env staging --remote",
    "d1:migrate:production": "wrangler d1 migrations apply COMMON_API_DB --env production --remote",
    "d1:seed:staging": "wrangler d1 execute COMMON_API_DB --env staging --remote --file seeds/release_notes_autoledger_versions.sql",
    "d1:seed:production": "wrangler d1 execute COMMON_API_DB --env production --remote --file seeds/release_notes_autoledger_versions.sql",
    "d1:seed:autonotice:staging": "wrangler d1 execute COMMON_API_DB --env staging --remote --file seeds/release_notes_autonotice_versions.sql",
    "d1:seed:autonotice:production": "wrangler d1 execute COMMON_API_DB --env production --remote --file seeds/release_notes_autonotice_versions.sql",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "types": "wrangler types"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.9",
    "wrangler": "^4.127.0"
  }
}
